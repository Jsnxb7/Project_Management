LOCAL_MONGO_URI=mongodb://127.0.0.1:27017
# Set this on Render. Keep the real value out of Git.
ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=ai_hrms_local
SECRET_KEY=change-this-local-secret
JWT_SECRET_KEY=change-this-local-jwt-secret
FLASK_ENV=development
MONGO_MAX_POOL_SIZE=200
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=20000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_FALLBACK_SELECTION_TIMEOUT_MS=5000
MONGO_RETRY_WRITES=true
